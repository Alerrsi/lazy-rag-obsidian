/* ==========================================================================
   ChatView styles
   Two zones: the intro (empty state) and the scrollable transcript.
   ========================================================================== */

ChatView {
    width: 1fr;
    height: 1fr;
    background: $background;
}

#messages {
    width: 100%;
    height: 100%;
    layout: vertical;
}

#chat-intro {
    width: 100%;
    height: auto;
    padding: 1 2;
}

#chat-empty {
    width: 100%;
    color: $ink;
    text-style: none;
}

#chat-scroll {
    width: 100%;
    height: 1fr;
    layout: vertical;
    padding: 0 1;
}

/* --- Message Cards: Diseño limpio y con aire ------------------------------ */

.message-header-bar {
    width: 100%;
    height: 1;
    layout: horizontal;
    margin-bottom: 0;
}

.message-sender-name {
    width: 1fr;
    color: $brand-bright;
    text-style: bold;
}

.assistant-name {
    color: $accent;
}

.message-timestamp {
    width: auto;
    color: $ink-faint;
    text-style: none;
    text-align: right;
}

/* 1. Tarjeta del Usuario:
      - Borde izquierdo primario grueso
      - Fondo panel sutil
      - Espaciado interior y superior
*/
.user-card {
    width: 100%;
    height: auto;
    background: $panel;
    border-left: thick $primary;
    padding: 1 2;
    margin-top: 1;
    margin-bottom: 2;
}

.user-text {
    width: 100%;
    color: $ink;
    text-style: none;
    margin-top: 0;
}

/* 2. Tarjeta del Asistente:
      - Más aire y separación respecto a la pregunta del usuario
      - Sin caja envolvente pesada, texto abierto y legible
      - Metadatos sutiles de Thought / Modelo
*/
.assistant-card {
    width: 100%;
    height: auto;
    background: transparent;
    padding: 0 2;
    margin-bottom: 2;
}

.assistant-meta-thought {
    width: 100%;
    height: auto;
    color: $accent;
    text-style: italic;
    margin-bottom: 1;
}

.assistant-markdown {
    width: 100%;
    color: $ink;
    background: transparent;
    padding: 0;
    margin-top: 0;
}

/* In-flight feedback. Sits under the log so it never shifts the transcript */
#chat-status {
    width: 100%;
    height: auto;
    color: $brand;
    text-style: none;
    padding: 0 0 1 0;
}
