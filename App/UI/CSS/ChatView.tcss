/* ==========================================================================
   Conversation pane — the primary surface of the app.
   ========================================================================== */

#chat {
    width: 1fr;
    min-width: 30;
    height: 1fr;
    background: $surface;
    color: $ink;
    border: round $line;
    border-title-color: $ink-faint;
    border-title-style: none;
    padding: 0 1;
}

#messages {
    width: 100%;
    height: 1fr;
}

/* Docked so the intro can be centred on its own, and height-capped so a
   cramped terminal clips the copy instead of pushing the conversation off screen. */
#chat-intro {
    width: 100%;
    height: auto;
    max-height: 100%;
    dock: top;
    align-horizontal: center;
    overflow-y: hidden;
}

#chat-scroll {
    width: 100%;
    height: 1fr;
    background: $surface;
    color: $ink;
    padding: 1 1;
    overflow-y: auto;
}

/* Empty state: fills the void until the first question is asked. */
#chat-empty {
    width: 1fr;
    max-width: 72%;
    height: auto;
    color: $ink-dim;
    background: $surface;
    text-align: left;
    text-style: none;
    padding: 3 0 1 0;
}

/* ==========================================================================
   Estilo de mensajes tipo Claude / Modern Prompt (como en la foto de referencia)
   ========================================================================== */

/* 1. Tarjeta de Usuario:
      - Borde grueso a la izquierda con el color primario/violeta
      - Fondo panel sutil
      - Espaciado interior y superior
*/
.user-card {
    width: 100%;
    height: auto;
    background: $panel;
    border-left: thick $primary;
    padding: 1 2;
    margin-top: 1;
    margin-bottom: 2;
}

.user-text {
    width: 100%;
    color: $ink;
    text-style: none;
}

/* 2. Tarjeta del Asistente:
      - Más aire y separación respecto a la pregunta del usuario
      - Sin caja envolvente pesada, texto abierto y legible
      - Metadatos sutiles de Thought / Modelo
*/
.assistant-card {
    width: 100%;
    height: auto;
    background: transparent;
    padding: 0 2;
    margin-bottom: 2;
}

.assistant-meta-thought {
    width: 100%;
    height: auto;
    color: $accent;
    text-style: italic;
    margin-bottom: 1;
}

.assistant-markdown {
    width: 100%;
    color: $ink;
    background: transparent;
    padding: 0;
}

/* In-flight feedback. Sits under the log so it never shifts the transcript */
#chat-status {
    width: 100%;
    height: auto;
    color: $brand;
    text-style: none;
    padding: 0 0 1 0;
}

/* --- Responsive ----------------------------------------------------------- */

#main.narrow #chat {
    margin-right: 0;
}

#main.narrow #chat-empty {
    max-width: 100%;
    padding: 1 0 0 0;
}

#main.narrow .user-card {
    padding: 1 1;
    margin-left: 0;
    margin-right: 0;
}

#main.narrow .assistant-card {
    padding: 0 1;
}

#main.short #chat {
    padding: 0;
}

#main.short #chat-empty {
    padding: 0;
}

#main.short .user-card {
    margin-top: 0;
    margin-bottom: 1;
    padding: 0 1;
}

#main.short .assistant-card {
    margin-bottom: 1;
}

/* Too little room for the intro to be read */
#main.tiny #chat-intro {
    display: none;
}

#main.micro #chat {
    border: none;
    padding: 0;
}
