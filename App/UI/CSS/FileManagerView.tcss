/* ==========================================================================
   Sidebar — vault tree.
   Proportional and interactive horizontal resizing next to the chat pane.
   ========================================================================== */

#sidebar {
    width: 34;
    min-width: 18;
    max-width: 50;
    height: 1fr;
    background: $surface;
    color: $ink;
    border: round $line;
    border-title-color: $ink-faint;
    border-title-style: none;
    padding: 0 1;
}

#sidebar-top-bar {
    width: 100%;
    height: 1;
    margin-bottom: 1;
    layout: horizontal;
}

#btn-change-vault {
    width: 1fr;
    height: 1;
    min-width: 0;
    background: $boost;
    color: $ink-dim;
    border: none;
    text-align: center;
}

#btn-change-vault:hover {
    background: $brand 30%;
    color: $brand-bright;
    text-style: bold;
}

#btn-close-sidebar {
    width: 3;
    height: 1;
    min-width: 3;
    margin-left: 1;
    background: $panel;
    color: $ink-faint;
    border: none;
    text-align: center;
    padding: 0;
}

#btn-close-sidebar:hover {
    background: $error 30%;
    color: $error-lighten-2;
    text-style: bold;
}

#vault-tree {
    width: 100%;
    height: 1fr;
    background: $surface;
    color: $ink-dim;
    padding: 0;
}

#vault-tree:focus {
    color: $ink;
}

/* Folders read as structure, files as content. */
#vault-tree > .directory-tree--folder {
    color: $ink;
    text-style: bold;
}

#vault-tree > .directory-tree--file {
    color: $ink-dim;
    text-style: none;
}

#vault-tree > .tree--guides {
    color: $line-strong;
    background: transparent;
}

#vault-tree > .tree--highlight,
#vault-tree > .tree--highlight-line {
    color: $ink;
    text-style: bold;
}

/* Cursor only lights up while the tree actually has focus. */
#vault-tree:focus > .tree--cursor {
    background: $primary 30%;
    color: $text;
    text-style: bold;
}

#vault-tree > .tree--cursor {
    color: $ink;
    text-style: bold;
}

#sidebar:focus-within {
    border: round $line-strong;
}

/* --- Responsive ----------------------------------------------------------- */

#main.narrow #sidebar {
    display: none;
}
